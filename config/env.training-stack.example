# SakuraMoon training-stack environment template (fully redacted).
#
# Rebuild the per-instance `.env.training-stack.nul` (chmod 600) from this
# template, then launch via scripts/training_stack.sh. The live NUL file is
# never committed: every value below is a placeholder or a standard
# platform default. Variable names mirror the SCNet DTK instance dump
# (51 keys, TORCHELASTIC_* excluded); shell/SSH session noise is omitted.

# --- Secrets: fill in per instance; never commit the real values ---------
MODELSCOPE_API_TOKEN=<modelscope-api-token>
WANDB_API_KEY=<wandb-api-key>
http_proxy=http://<proxy-user>:<proxy-password>@<proxy-host>:<proxy-port>
https_proxy=http://<proxy-user>:<proxy-password>@<proxy-host>:<proxy-port>
ftp_proxy=http://<proxy-user>:<proxy-password>@<proxy-host>:<proxy-port>
no_proxy=<internal-domains>,localhost,127.0.0.1

# --- Institution NFS shares (adapt paths to the local site) -------------
SCNET_USER_HOME=/public/home/<team-account>
SCNET_TEAM_SHARE=/public/share/<team>
SCNET_SHARING_CENTER=/public/<organization>/sharingCenter

# --- DTK / ROCm platform (standard SCNet DTK image layout) --------------
AMDGPU_TARGETS=gfx906;gfx926;gfx928;gfx936;gfx938
ROCM_PATH=/opt/dtk
DTKROOT=/opt/dtk
HIP_PATH=/opt/dtk/hip
HYHAL_PATH=/opt/hyhal
CMAKE_PREFIX_PATH=/opt/hyhal:/opt/dtk/.hyhal/rocm_smi/
CPLUS_INCLUDE_PATH=/opt/dtk/dcc/gcvm/include:/opt/dtk/include:/opt/hyhal/include:/opt/dtk/llvm/include:/opt/dtk/dushmem/include:/opt/dtk/opencl/include:/opt/dtk/.hyhal/rocm_smi/include
C_INCLUDE_PATH=/opt/dtk/dcc/gcvm/include:/opt/dtk/include:/opt/hyhal/include:/opt/dtk/llvm/include:/opt/dtk/dushmem/include:/opt/dtk/opencl/include:/opt/dtk/.hyhal/rocm_smi/include
LIBRARY_PATH=/opt/hyhal/lib:/opt/dtk/opencl/lib:/opt/dtk/dushmem/lib:/opt/dtk/.hyhal/rocm_smi/lib
LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:/opt/mpi/lib:/opt/hwloc/lib:/opt/dtk/dcc/gcvm/lib:/opt/dtk/hip/lib:/opt/dtk/llvm/lib:/opt/dtk/lib:/opt/dtk/lib64:/opt/hyhal/lib:/opt/hyhal/lib64:/opt/dtk/dushmem/lib:/opt/dtk/opencl/lib:/opt/dtk/.hyhal/rocm_smi/lib
CUDA_HOME=/usr/local/cuda

# --- Runtime tuning -------------------------------------------------------
MIOPEN_FIND_MODE=3
PYTORCH_MIOPEN_SUGGEST_NDHWC=1
ALLREDUCE_STREAM_WITH_COMPUTE=1
HIP_KERNEL_EVENT_SYSTENFENCE=1
HIP_USE_GRAPH_QUEUE_POOL=1
NCCL_NCHANNELS_PER_PEER=2
# List the cards this instance actually sees (the DTK image exposes 16 by
# default; G1 world_size=2 runs with two, e.g. 0,1).
HIP_VISIBLE_DEVICES=<visible-cards>

# --- Project ---------------------------------------------------------------
# Project root containing src/ and config/ (the training_stack.sh script
# prepends <project-root>/src to PYTHONPATH).
PYTHONPATH=<project-root>
HF_ENDPOINT=https://hf-mirror.com
# Optional override for the TorchInductor cache directory; training_stack.sh
# exports a project-local default unless this is set.
# SAKURAMOON_TORCHINDUCTOR_CACHE_DIR=<cache-dir>
