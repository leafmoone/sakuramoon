# Local model, metadata, dataset and cache assets. These paths are anchored so
# future source packages such as src/sakuramoon/model remain trackable.
/model/
/db/
/data/
/cache/
/reference/

# Model weights and local databases remain local and must never be tracked.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.db
*.sqlite
*.sqlite3
*.duckdb

# Training and evaluation artifacts
/artifacts/
/output_model/
/outputs/
/samples/
/runs/
/wandb/
/profiles/
/profile/
/traces/
/diagnostics/

# Temporary files
*.tmp
*.partial
.ipynb_checkpoints/
._____temp/
